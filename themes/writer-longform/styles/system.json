{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "System",
    "settings": {
        "color": {
            "palette": [
                { "slug": "base", "name": "Base", "color": "#ffffff" },
                { "slug": "surface", "name": "Surface", "color": "#f3f2f0" },
                { "slug": "line", "name": "Line", "color": "#e6e4e1" },
                { "slug": "muted", "name": "Muted", "color": "#767573" },
                { "slug": "contrast", "name": "Contrast", "color": "#333333" },
                { "slug": "accent", "name": "Accent", "color": "#cb4649" },
                { "slug": "accent-contrast", "name": "On accent", "color": "#ffffff" }
            ]
        },
        "custom": {
            "error": "#b32d2e"
        }
    },
    "styles": {
        "css": "@media (prefers-color-scheme: dark){:root{color-scheme:dark;--wp--preset--color--base:#2b2c30;--wp--preset--color--surface:#36383c;--wp--preset--color--line:#36383c;--wp--preset--color--muted:#939598;--wp--preset--color--contrast:#dcdcdc;--wp--preset--color--accent:#e47274;--wp--preset--color--accent-contrast:#111111;--wp--custom--error:#ff8f86;--wp--custom--hero--background:#1f2023}}"
    }
}
