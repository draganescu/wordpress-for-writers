{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "680px",
            "wideSize": "1040px"
        },
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                { "slug": "base", "name": "Base", "color": "#ffffff" },
                { "slug": "surface", "name": "Surface", "color": "#f7f6f3" },
                { "slug": "line", "name": "Line", "color": "#e6e4df" },
                { "slug": "muted", "name": "Muted", "color": "#6a6862" },
                { "slug": "contrast", "name": "Contrast", "color": "#222120" },
                { "slug": "accent", "name": "Accent", "color": "#2f4a8a" },
                { "slug": "accent-contrast", "name": "On accent", "color": "#ffffff" }
            ]
        },
        "custom": {
            "error": "#b32d2e"
        },
        "typography": {
            "defaultFontSizes": false,
            "dropCap": true,
            "fluid": false,
            "fontFamilies": [
                {
                    "name": "Literata",
                    "slug": "serif",
                    "fontFamily": "Literata, Georgia, \"Times New Roman\", serif",
                    "fontFace": [
                        {
                            "fontFamily": "Literata",
                            "fontStyle": "normal",
                            "fontWeight": "200 900",
                            "fontDisplay": "swap",
                            "src": [ "file:./assets/fonts/literata-normal.woff2" ]
                        },
                        {
                            "fontFamily": "Literata",
                            "fontStyle": "italic",
                            "fontWeight": "200 900",
                            "fontDisplay": "swap",
                            "src": [ "file:./assets/fonts/literata-italic.woff2" ]
                        }
                    ]
                },
                {
                    "name": "Inter",
                    "slug": "sans",
                    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Inter",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "fontDisplay": "swap",
                            "src": [ "file:./assets/fonts/inter-normal.woff2" ]
                        }
                    ]
                },
                {
                    "name": "System sans",
                    "slug": "system",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
                }
            ],
            "fontSizes": [
                { "slug": "x-small", "name": "Extra small", "size": "0.8125rem" },
                { "slug": "small", "name": "Small", "size": "0.9375rem" },
                { "slug": "medium", "name": "Medium", "size": "clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem)" },
                { "slug": "large", "name": "Large", "size": "clamp(1.3rem, 1.15rem + 0.6vw, 1.625rem)" },
                { "slug": "x-large", "name": "Extra large", "size": "clamp(1.625rem, 1.3rem + 1.3vw, 2.25rem)" },
                { "slug": "xx-large", "name": "Huge", "size": "clamp(2.375rem, 1.6rem + 3.2vw, 3.75rem)" }
            ]
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "units": [ "px", "em", "rem", "%", "vh", "vw" ],
            "spacingSizes": [
                { "slug": "20", "name": "2X-Small", "size": "0.5rem" },
                { "slug": "30", "name": "X-Small", "size": "0.75rem" },
                { "slug": "40", "name": "Small", "size": "clamp(1rem, 0.8rem + 0.8vw, 1.5rem)" },
                { "slug": "50", "name": "Medium", "size": "clamp(1.5rem, 1rem + 2vw, 2.5rem)" },
                { "slug": "60", "name": "Large", "size": "clamp(2.25rem, 1.4rem + 3.4vw, 4rem)" },
                { "slug": "70", "name": "X-Large", "size": "clamp(3.5rem, 2.2rem + 5.2vw, 6.5rem)" }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
            "padding": {
                "left": "var(--wp--preset--spacing--40)",
                "right": "var(--wp--preset--spacing--40)"
            },
            "blockGap": "1.6rem"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--serif)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.72"
        },
        "elements": {
            "link": {
                "color": { "text": "currentColor" },
                "typography": { "textDecoration": "underline" },
                ":hover": { "color": { "text": "var(--wp--preset--color--accent)" } },
                ":focus": { "color": { "text": "var(--wp--preset--color--accent)" } }
            },
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--serif)",
                    "fontWeight": "600",
                    "lineHeight": "1.2",
                    "letterSpacing": "-0.015em"
                }
            },
            "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.08" } },
            "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
            "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
            "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--contrast)",
                    "text": "var(--wp--preset--color--base)"
                },
                "border": { "radius": "999px" },
                "spacing": {
                    "padding": { "top": "0.55em", "bottom": "0.55em", "left": "1.15em", "right": "1.15em" }
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "500"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--accent)",
                        "text": "var(--wp--preset--color--accent-contrast)"
                    }
                }
            },
            "caption": {
                "color": { "text": "var(--wp--preset--color--muted)" },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontSize": "var(--wp--preset--font-size--x-small)"
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--serif)",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "600",
                    "letterSpacing": "-0.01em"
                },
                "elements": {
                    "link": { "typography": { "textDecoration": "none" } }
                }
            },
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "core/post-title": {
                "elements": {
                    "link": { "typography": { "textDecoration": "none" } }
                }
            },
            "core/post-date": {
                "color": { "text": "var(--wp--preset--color--muted)" },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontSize": "var(--wp--preset--font-size--x-small)"
                }
            },
            "core/post-author-name": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "500"
                }
            },
            "core/post-excerpt": {
                "color": { "text": "var(--wp--preset--color--muted)" }
            },
            "core/post-terms": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontSize": "var(--wp--preset--font-size--x-small)"
                }
            },
            "core/query-pagination": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "core/quote": {
                "border": {
                    "left": { "color": "var(--wp--preset--color--contrast)", "width": "3px", "style": "solid" }
                },
                "spacing": { "padding": { "left": "1.5rem" } },
                "typography": { "fontStyle": "italic" }
            },
            "core/pullquote": {
                "border": {
                    "top": { "width": "0px", "style": "none" },
                    "bottom": { "width": "0px", "style": "none" }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)",
                    "fontStyle": "italic",
                    "lineHeight": "1.35"
                }
            },
            "core/code": {
                "color": { "background": "var(--wp--preset--color--surface)" },
                "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
            },
            "core/separator": {
                "color": { "text": "var(--wp--preset--color--muted)" }
            },
            "core/search": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "core/comments": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            }
        }
    },
    "templateParts": [
        { "name": "header", "title": "Header", "area": "header" },
        { "name": "footer", "title": "Footer", "area": "footer" },
        { "name": "footer-minimal", "title": "Footer without subscribe form", "area": "footer" },
        { "name": "author-bio", "title": "Author bio", "area": "uncategorized" }
    ],
    "customTemplates": [
        { "name": "single-drop-cap", "title": "Essay with drop cap", "postTypes": [ "post" ] }
    ]
}
