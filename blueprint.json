{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/wp-admin/admin.php?page=wfw",
    "preferredVersions": {
        "php": "8.3",
        "wp": "latest"
    },
    "steps": [
        {
            "step": "login"
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/draganescu/wordpress-for-writers",
                "ref": "trunk",
                "refType": "branch"
            },
            "options": {
                "activate": true,
                "targetFolderName": "wordpress-for-writers"
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/draganescu/wordpress-for-writers",
                "ref": "trunk",
                "refType": "branch",
                "path": "plugins/writer-subscribe"
            },
            "options": {
                "activate": true,
                "targetFolderName": "writer-subscribe"
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/draganescu/wordpress-for-writers",
                "ref": "trunk",
                "refType": "branch",
                "path": "plugins/writer-members"
            },
            "options": {
                "activate": true,
                "targetFolderName": "writer-members"
            }
        },
        {
            "step": "installTheme",
            "themeData": {
                "resource": "git:directory",
                "url": "https://github.com/draganescu/wordpress-for-writers",
                "ref": "trunk",
                "refType": "branch",
                "path": "themes/writer-newsletter"
            },
            "options": {
                "activate": true,
                "targetFolderName": "writer-newsletter"
            }
        },
        {
            "step": "installTheme",
            "themeData": {
                "resource": "git:directory",
                "url": "https://github.com/draganescu/wordpress-for-writers",
                "ref": "trunk",
                "refType": "branch",
                "path": "themes/writer-essay"
            },
            "options": {
                "activate": false,
                "targetFolderName": "writer-essay"
            }
        },
        {
            "step": "installTheme",
            "themeData": {
                "resource": "git:directory",
                "url": "https://github.com/draganescu/wordpress-for-writers",
                "ref": "trunk",
                "refType": "branch",
                "path": "themes/writer-longform"
            },
            "options": {
                "activate": false,
                "targetFolderName": "writer-longform"
            }
        },
        {
            "step": "runPHP",
            "code": "<?php require '/wordpress/wp-load.php'; require WP_PLUGIN_DIR . '/wordpress-for-writers/playground/demo-content.php'; require WP_PLUGIN_DIR . '/wordpress-for-writers/playground/demo-audience.php';"
        }
    ]
}
